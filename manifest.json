{
  "manifest_version": 3,
  "name": "Maps AI Review Generator",
  "version": "1.1",
  "description": "Reads the open Google Maps place and generates authentic AI reviews and matching images via Gemini, OpenAI-compatible endpoints, or a Copilot proxy.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "downloads",
    "sidePanel",
    "clipboardWrite"
  ],
  "host_permissions": [
    "https://www.google.com/maps/*",
    "https://generativelanguage.googleapis.com/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "action": {
    "default_title": "Open Maps AI Review"
  }
}
